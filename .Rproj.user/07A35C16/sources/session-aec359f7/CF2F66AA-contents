#!/usr/bin/env Rscript
# ------------------------------------------------------------------
# portfolio_tracker.R
#
# Reads an Excel file of holdings (Ticker, Shares, CostBasis), pulls the
# most recent closing price for each ticker from Yahoo Finance, and
# writes a summary with market value and gain/loss per position and for
# the portfolio as a whole.
#
# INPUT COLUMNS (first row = headers; names are case-insensitive)
#   Ticker      e.g. AAPL
#   Shares      number of shares held
#   CostBasis   TOTAL dollars paid for the position (not per share).
#               If your sheet holds per-share cost, set
#               COST_BASIS_IS_PER_SHARE <- TRUE below.
#
# USAGE (no terminal needed)
#   1. Open this file in RStudio.
#   2. Click the "Source" button (or press Ctrl/Cmd + Shift + S).
#   3. A window opens: pick your holdings .xlsx file.
#   The report is saved in the SAME folder as your holdings file, as
#   "portfolio_report.xlsx", and it opens automatically when done.
#
# The holdings file can live anywhere; you choose it in the window.
# ------------------------------------------------------------------

# ---- Settings ----------------------------------------------------
# Leave INPUT_FILE as NULL to get the file-picker window. Or paste a full
# path to skip it, e.g. "C:/Users/you/Documents/holdings.xlsx"
INPUT_FILE   <- NULL
OPEN_REPORT_WHEN_DONE <- TRUE
COST_BASIS_IS_PER_SHARE <- FALSE
LOOKBACK_DAYS <- 10   # window used to find the latest close (covers weekends/holidays)

# ---- Packages ----------------------------------------------------
needed <- c("readxl", "quantmod", "openxlsx")
missing_pkgs <- needed[!vapply(needed, requireNamespace, logical(1), quietly = TRUE)]
if (length(missing_pkgs) > 0) {
  message("Installing missing packages: ", paste(missing_pkgs, collapse = ", "))
  install.packages(missing_pkgs, repos = "https://cloud.r-project.org")
}
suppressPackageStartupMessages({
  library(readxl)
  library(quantmod)
  library(openxlsx)
})

# ---- Choose the input file --------------------------------------
if (is.null(INPUT_FILE)) {
  message("Select your holdings .xlsx file in the window that opens...")
  INPUT_FILE <- tryCatch(file.choose(), error = function(e) NULL)
  if (is.null(INPUT_FILE)) stop("No file selected.")
}
# Save the report next to the holdings file
OUTPUT_FILE <- file.path(dirname(INPUT_FILE), "portfolio_report.xlsx")

# ---- Read and validate holdings ---------------------------------
read_holdings <- function(path) {
  if (!file.exists(path)) stop("Input file not found: ", path)
  df <- as.data.frame(read_excel(path))
  names(df) <- tolower(trimws(names(df)))

  required <- c("ticker", "shares", "costbasis")
  absent <- setdiff(required, names(df))
  if (length(absent) > 0) {
    stop("Missing column(s): ", paste(absent, collapse = ", "),
         ". Expected headers: Ticker, Shares, CostBasis")
  }

  df <- df[, required]
  df$ticker    <- toupper(trimws(as.character(df$ticker)))
  df$shares    <- as.numeric(df$shares)
  df$costbasis <- as.numeric(df$costbasis)
  df <- df[!is.na(df$ticker) & df$ticker != "", ]

  bad <- is.na(df$shares) | is.na(df$costbasis)
  if (any(bad)) {
    stop("Non-numeric Shares/CostBasis for: ", paste(df$ticker[bad], collapse = ", "))
  }

  # Combine duplicate tickers (e.g., several purchase lots)
  if (anyDuplicated(df$ticker)) {
    message("Duplicate tickers found; combining lots.")
    df <- aggregate(cbind(shares, costbasis) ~ ticker, data = df, FUN = sum)
  }
  if (COST_BASIS_IS_PER_SHARE) df$costbasis <- df$costbasis * df$shares
  df
}

# ---- Fetch latest close -----------------------------------------
get_last_close <- function(sym) {
  tryCatch({
    px <- suppressWarnings(getSymbols(
      sym,
      src = "yahoo",
      from = Sys.Date() - LOOKBACK_DAYS,
      auto.assign = FALSE,
      warnings = FALSE
    ))
    cl <- Cl(px)
    cl <- cl[!is.na(cl)]
    if (nrow(cl) == 0) stop("no data returned")
    list(price = as.numeric(last(cl)), date = as.Date(index(last(cl))))
  }, error = function(e) {
    warning("Could not retrieve price for ", sym, ": ", conditionMessage(e),
            call. = FALSE)
    list(price = NA_real_, date = as.Date(NA))
  })
}

# ---- Main --------------------------------------------------------
holdings <- read_holdings(INPUT_FILE)
message("Fetching prices for ", nrow(holdings), " tickers...")

quotes <- lapply(holdings$ticker, get_last_close)
holdings$price      <- vapply(quotes, function(q) q$price, numeric(1))
holdings$price_date <- as.Date(vapply(quotes, function(q) as.numeric(q$date), numeric(1)),
                               origin = "1970-01-01")

holdings$market_value <- holdings$shares * holdings$price
holdings$gain_loss    <- holdings$market_value - holdings$costbasis
holdings$gain_loss_pct <- holdings$gain_loss / holdings$costbasis

report <- data.frame(
  Ticker         = holdings$ticker,
  Shares         = holdings$shares,
  CostBasis      = holdings$costbasis,
  ClosePrice     = holdings$price,
  PriceDate      = holdings$price_date,
  MarketValue    = holdings$market_value,
  GainLoss       = holdings$gain_loss,
  GainLossPct    = holdings$gain_loss_pct,
  PortfolioPct   = holdings$market_value / sum(holdings$market_value, na.rm = TRUE),
  stringsAsFactors = FALSE
)

# Portfolio totals use only positions with a valid price, so a failed
# lookup does not silently distort gain/loss.
ok <- !is.na(report$MarketValue)
tot_cost  <- sum(report$CostBasis[ok])
tot_value <- sum(report$MarketValue[ok])
tot_gl    <- tot_value - tot_cost

# ---- Console output ---------------------------------------------
fmt <- report
fmt$CostBasis    <- sprintf("%12s", format(round(fmt$CostBasis, 2),   big.mark = ",", nsmall = 2))
fmt$ClosePrice   <- sprintf("%9.2f", fmt$ClosePrice)
fmt$MarketValue  <- sprintf("%12s", format(round(fmt$MarketValue, 2), big.mark = ",", nsmall = 2))
fmt$GainLoss     <- sprintf("%12s", format(round(fmt$GainLoss, 2),    big.mark = ",", nsmall = 2))
fmt$GainLossPct  <- sprintf("%7.2f%%", 100 * fmt$GainLossPct)
fmt$PortfolioPct <- sprintf("%6.1f%%", 100 * fmt$PortfolioPct)
cat("\n"); print(fmt, row.names = FALSE); cat("\n")
cat(sprintf("Total cost basis : $%s\n", format(round(tot_cost, 2),  big.mark = ",", nsmall = 2)))
cat(sprintf("Portfolio value  : $%s\n", format(round(tot_value, 2), big.mark = ",", nsmall = 2)))
cat(sprintf("Total gain/loss  : $%s (%.2f%%)\n",
            format(round(tot_gl, 2), big.mark = ",", nsmall = 2),
            100 * tot_gl / tot_cost))
if (any(!ok)) {
  cat("\nWARNING: no price found for: ", paste(report$Ticker[!ok], collapse = ", "),
      " (excluded from totals)\n", sep = "")
}

# ---- Excel output -------------------------------------------------
wb <- createWorkbook()
addWorksheet(wb, "Portfolio")

writeData(wb, "Portfolio", report, startRow = 1)
n <- nrow(report)
last_row <- n + 1
total_row <- n + 3

# Totals row (live Excel formulas so the file stays auditable)
writeData(wb, "Portfolio", "PORTFOLIO TOTAL", startCol = 1, startRow = total_row)
# Cost total counts only positions that have a price, matching the console totals
writeFormula(wb, "Portfolio", sprintf("SUMIFS(C2:C%d,F2:F%d,\"<>\")", last_row, last_row), startCol = 3, startRow = total_row)
writeFormula(wb, "Portfolio", sprintf("SUM(F2:F%d)", last_row), startCol = 6, startRow = total_row)
writeFormula(wb, "Portfolio", sprintf("SUM(G2:G%d)", last_row), startCol = 7, startRow = total_row)
writeFormula(wb, "Portfolio", sprintf("IF(C%d=0,\"\",G%d/C%d)", total_row, total_row, total_row),
             startCol = 8, startRow = total_row)
writeData(wb, "Portfolio", paste("Prices as of most recent close; report generated", Sys.Date()),
          startCol = 1, startRow = total_row + 2)

hdr    <- createStyle(textDecoration = "bold", fgFill = "#1F3864", fontColour = "#FFFFFF",
                      halign = "center", border = "bottom")
money  <- createStyle(numFmt = "$#,##0.00")
pct    <- createStyle(numFmt = "0.00%")
shares <- createStyle(numFmt = "#,##0.####")
datef  <- createStyle(numFmt = "yyyy-mm-dd", halign = "center")
totsty <- createStyle(textDecoration = "bold", border = "top")
green  <- createStyle(fontColour = "#006100", bgFill = "#C6EFCE")
red    <- createStyle(fontColour = "#9C0006", bgFill = "#FFC7CE")

addStyle(wb, "Portfolio", hdr, rows = 1, cols = 1:9, gridExpand = TRUE)
addStyle(wb, "Portfolio", shares, rows = 2:last_row, cols = 2, gridExpand = TRUE)
addStyle(wb, "Portfolio", money,  rows = 2:total_row, cols = c(3, 4, 6, 7), gridExpand = TRUE, stack = TRUE)
addStyle(wb, "Portfolio", datef,  rows = 2:last_row, cols = 5, gridExpand = TRUE)
addStyle(wb, "Portfolio", pct,    rows = 2:total_row, cols = c(8, 9), gridExpand = TRUE, stack = TRUE)
addStyle(wb, "Portfolio", totsty, rows = total_row, cols = 1:9, gridExpand = TRUE, stack = TRUE)

conditionalFormatting(wb, "Portfolio", cols = 7:8, rows = 2:total_row, rule = ">0", style = green)
conditionalFormatting(wb, "Portfolio", cols = 7:8, rows = 2:total_row, rule = "<0", style = red)

setColWidths(wb, "Portfolio", cols = 1:9, widths = c(18, 10, 14, 12, 12, 16, 14, 13, 13))
freezePane(wb, "Portfolio", firstRow = TRUE)

tryCatch(
  saveWorkbook(wb, OUTPUT_FILE, overwrite = TRUE),
  error = function(e) stop(
    "Could not save the report. If portfolio_report.xlsx is open in Excel, close it and run again.\n",
    conditionMessage(e), call. = FALSE)
)
message("\nReport written to: ", normalizePath(OUTPUT_FILE))
if (OPEN_REPORT_WHEN_DONE) openXL(OUTPUT_FILE)
